# --- Database ---------------------------------------------------------------
# Production / staging (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://qip:qip@localhost:5432/qip
# Local MVP default (no server needed):
DATABASE_URL=sqlite:///./qip.db

# --- Security ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- AI ---------------------------------------------------------------------
# Leave blank to run the deterministic offline extractor (everything is then
# flagged "Requires Manual Verification").
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_CONFIDENCE_THRESHOLD=0.75
AI_MAX_PAGES=6

# --- Misc -------------------------------------------------------------------
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000
COMPANY_NAME=Precision Components Pvt. Ltd.
